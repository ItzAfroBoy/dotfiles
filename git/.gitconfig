[user]
    name = Brett
    email = me.caramackid@gmail.com
    signingkey = /home/br3tt/.ssh/id_ed25519.pub
[core]
    editor = nvim
[push]
    autoSetupRemote = true
[gpg]
    format = ssh
[commit]
    gpgsign = true
[filter "lfs"]
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
[init]
    defaultBranch = main
